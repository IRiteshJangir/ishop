# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB Connection String
# For Local: mongodb://127.0.0.1:27017/ISHOP
# For MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ISHOP?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.mongodb.net/ISHOP?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=ishop_production_secret_key_change_me_in_hosting_environment_2026

# Allowed Frontend URL for CORS (e.g., https://your-domain.vercel.app)
FRONTEND_URL=*
